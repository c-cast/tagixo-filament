{
    "name": "tagixo/filament",
    "description": "Filament SDK for Tagixo: one admin resource per record type the installed builders register. Succeeds ccast/tagixo-filament 1.x.",
    "type": "library",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "tagixo"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "cCast S.r.l.",
            "email": "software@ccast.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "symfony/expression-language": "^6.4|^7.0",
        "tagixo/core": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "tagixo/document-builder": "^0.1",
        "tagixo/form-builder": "^0.1",
        "tagixo/mail-builder": "^0.1",
        "tagixo/page-builder": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Tagixo\\Filament\\": "src/",
            "Ccast\\TagixoFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tagixo\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Tagixo\\Filament\\TagixoFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "repositories": {
        "tagixo": {
            "type": "path",
            "url": "../../Projects/tagixo/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "tagixo/core": "0.1.x-dev",
                    "tagixo/page-builder": "0.1.x-dev",
                    "tagixo/form-builder": "0.1.x-dev",
                    "tagixo/mail-builder": "0.1.x-dev",
                    "tagixo/document-builder": "0.1.x-dev",
                    "tagixo/slider-builder": "0.1.x-dev"
                }
            }
        }
    }
}
